{
  "appId": "cn.rphub.dev",
  "appName": "RP Hub",
  "webDir": "dist",
  "server": {
    "iosScheme": "capacitor",
    "cleartext": true
  },
  "ios": {
    "backgroundColor": "#f9fafb"
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": false
    },
    "Keyboard": {
      "resize": "body",
      "resizeOnFullScreen": true
    },
    "StatusBar": {
      "overlaysWebView": false,
      "style": "DEFAULT",
      "backgroundColor": "#f9fafb"
    },
    "SplashScreen": {
      "launchAutoHide": true,
      "backgroundColor": "#f9fafb",
      "showSpinner": false
    }
  }
}
